# ─────────────────────────────────────────────────────────────────────────────
# AI Ops — environment variable template
# Copy to .env and fill in real values. Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Jira
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_USER=service-account@yourorg.com
JIRA_API_TOKEN=<jira-api-token>
JIRA_PROJECT_KEY=OPS

# Confluence
CONFLUENCE_BASE_URL=https://yourorg.atlassian.net
CONFLUENCE_SPACE_KEY=KB
CONFLUENCE_PARENT_PAGE_ID=

# Azure Storage (mobile logs)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_FILE_SHARE_NAME=mobile-logs
AZURE_LOG_DIRECTORY=

# Datadog (server logs + monitoring)
DATADOG_API_KEY=<datadog-api-key>
DATADOG_APP_KEY=<datadog-app-key>
DATADOG_SITE=datadoghq.com
DATADOG_LOG_LOOKBACK_HOURS=6

# OpenAI (use one of the two blocks below)
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o

# Azure OpenAI (takes precedence over OPENAI_API_KEY if set)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourorg.com
SMTP_PASSWORD=<smtp-password>
ALERT_EMAIL_RECIPIENTS=oncall@yourorg.com,team@yourorg.com

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# ML model artifacts directory
ARTIFACTS_DIR=artifacts

# Log alert thresholds
ERROR_COUNT_THRESHOLD=50
WARNING_COUNT_THRESHOLD=200
FATAL_COUNT_THRESHOLD=5

# Retrieval
TOP_K_SIMILAR_TICKETS=5
TOP_K_LOG_LINES=20
TOP_K_CONFLUENCE=3
